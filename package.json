{
      "name": "autocomplete-english-word",
      "displayName": "English word hint",
      "description": "English word autocompletion for Visual Studio Code",
      "version": "0.2.0",
      "license": "GPL-3.0",
      "publisher": "wushuaiBUAA",
      "author": "wushuaiBUAA",
      "engines": {
            "vscode": "^1.1.0"
      },
      "icon": "icon/icon.png",
      "galleryBanner": {
            "color": "#FFF5F5",
            "theme": "light"
      },
      "categories": [
            "Snippets"
      ],
      "keywords": [
            "vscode",
            "English words",
            "hint",
            "autocompletion"
      ],
      "main": "./extension/main",
      "scripts": {
            "build": "node split_words.js",
            "vscode:prepublish": "npm run build"
      },
      "devDependencies": {
            "vscode": "^1.9.0",
             "fs-extra": "^12.0.1",  
            "colors": "^3.1.4",  
            "cheerio": "^1.0.0-rc.12", 
            "request": "^2.88.0" 
      },
      "dependencies": {
            "sourcemap": "^0.1.0"
      },
      "repository": {
            "type": "git",
            "url": "https://github.com/wushuaibuaa/vsautocomplete-en-en"
      },
      "homepage": "https://github.com/wushuaibuaa/vsautocomplete-en-en",
      "activationEvents": [
            "onLanguage:markdown",
            "onLanguage:latex"
      ],
      "contributes": {
            "configuration": {
                  "title": "English Word Hint",
                  "properties": {
                        "englishWordHint.enabled": {
                              "type": "boolean",
                              "default": true,
                              "description": "Enable English word completion and hover hints."
                        },
                        "englishWordHint.minPrefixLength": {
                              "type": "number",
                              "default": 2,
                              "minimum": 1,
                              "maximum": 10,
                              "description": "Minimum number of typed characters before completion suggestions appear."
                        },
                        "englishWordHint.maxResults": {
                              "type": "number",
                              "default": 100,
                              "minimum": 1,
                              "maximum": 1000,
                              "description": "Maximum number of completion suggestions returned at once."
                        }
                  }
            },
            "configurationDefaults": {
                  "[markdown]": {
                        "editor.quickSuggestions": true
                  }
            }
      }
}