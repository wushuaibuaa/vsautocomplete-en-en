{
      "name": "autocomplete-english-word",
      "displayName": "English word hint",
      "description": "English word autocompletion for Visual Studio Code",
      "version": "0.4.1",
      "license": "GPL-3.0",
      "publisher": "wushuaiBUAA",
      "author": "wushuaiBUAA",
      "engines": {
            "vscode": "^1.75.0"
      },
      "icon": "icon/icon.png",
      "galleryBanner": {
            "color": "#FFF5F5",
            "theme": "light"
      },
      "categories": [
            "Snippets"
      ],
      "keywords": [
            "vscode",
            "English words",
            "hint",
            "autocompletion"
      ],
      "main": "./extension/main",
      "scripts": {
            "build": "node scripts/split-words.js",
            "pretest": "npm run build",
            "test": "node --test",
            "package": "vsce package",
            "vscode:prepublish": "npm run build"
      },
      "devDependencies": {
            "@types/vscode": "^1.75.0",
            "@vscode/vsce": "^4.1.1",
            "subtlex-word-frequencies": "^2.0.0"
      },
      "repository": {
            "type": "git",
            "url": "https://github.com/wushuaibuaa/vsautocomplete-en-en"
      },
      "homepage": "https://github.com/wushuaibuaa/vsautocomplete-en-en",
      "activationEvents": [
            "onLanguage:markdown",
            "onLanguage:latex",
            "onLanguage:plaintext",
            "onCommand:englishWordHint.addUserWord",
            "onCommand:englishWordHint.ignoreWord",
            "onCommand:englishWordHint.showFullEntry"
      ],
      "contributes": {
            "configuration": {
                  "title": "English Word Hint",
                  "properties": {
                        "englishWordHint.enabled": {
                              "type": "boolean",
                              "default": true,
                              "description": "Master switch for the extension."
                        },
                        "englishWordHint.completionEnabled": {
                              "type": "boolean",
                              "default": true,
                              "description": "Enable completion suggestions."
                        },
                        "englishWordHint.hoverEnabled": {
                              "type": "boolean",
                              "default": true,
                              "description": "Enable hover definitions."
                        },
                        "englishWordHint.languages": {
                              "type": "array",
                              "items": {
                                    "type": "string"
                              },
                              "default": ["markdown", "latex", "plaintext"],
                              "description": "Language IDs where the extension is active."
                        },
                        "englishWordHint.userWords": {
                              "type": "array",
                              "items": {
                                    "type": "string"
                              },
                              "default": [],
                              "description": "Extra words offered in completion and hover."
                        },
                        "englishWordHint.ignoredWords": {
                              "type": "array",
                              "items": {
                                    "type": "string"
                              },
                              "default": [],
                              "description": "Words suppressed from completion and hover."
                        },
                        "englishWordHint.minPrefixLength": {
                              "type": "number",
                              "default": 2,
                              "minimum": 1,
                              "maximum": 10,
                              "description": "Minimum number of typed characters before completion suggestions appear."
                        },
                        "englishWordHint.maxResults": {
                              "type": "number",
                              "default": 100,
                              "minimum": 1,
                              "maximum": 1000,
                              "description": "Maximum number of completion suggestions returned at once."
                        }
                  }
            },
            "commands": [
                  {
                        "command": "englishWordHint.addUserWord",
                        "title": "Add Word to User Dictionary",
                        "category": "English Word Hint"
                  },
                  {
                        "command": "englishWordHint.ignoreWord",
                        "title": "Ignore Word",
                        "category": "English Word Hint"
                  },
                  {
                        "command": "englishWordHint.showFullEntry",
                        "title": "Show Full Entry",
                        "category": "English Word Hint"
                  }
            ],
            "menus": {
                  "editor/context": [
                        {
                              "command": "englishWordHint.showFullEntry",
                              "when": "editorLangId == markdown || editorLangId == latex || editorLangId == plaintext",
                              "group": "navigation@10"
                        },
                        {
                              "command": "englishWordHint.addUserWord",
                              "when": "editorLangId == markdown || editorLangId == latex || editorLangId == plaintext",
                              "group": "navigation@11"
                        },
                        {
                              "command": "englishWordHint.ignoreWord",
                              "when": "editorLangId == markdown || editorLangId == latex || editorLangId == plaintext",
                              "group": "navigation@12"
                        }
                  ]
            },
            "configurationDefaults": {
                  "[markdown]": {
                        "editor.quickSuggestions": true
                  },
                  "[plaintext]": {
                        "editor.quickSuggestions": true
                  }
            }
      }
}
